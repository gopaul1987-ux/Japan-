<script>
function openTab(evt, tabName, cityName) {
    const parentCard = evt.currentTarget.closest('.card');
    
    const cardContents = parentCard.querySelectorAll(".tab-content");
    const cardButtons = parentCard.querySelectorAll(".tab-button");

    cardContents.forEach(c => c.classList.remove("active"));
    cardButtons.forEach(b => b.classList.remove("active"));

    document.getElementById(tabName).classList.add("active");
    evt.currentTarget.classList.add("active");

    // Dynamic weather switching when browsing the main itinerary planner tabs
    if (cityName && travelWeather && travelWeather[cityName]) {
        document.getElementById("weatherBox").innerHTML = travelWeather[cityName];
        document.getElementById("weatherTitle").innerText = cityName + " Weather";
    }
}
</script>

