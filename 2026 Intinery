<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    // 1. Seasonal Historical Weather Benchmarks (Late June - Early July)
    const travelWeather = {
        "Tokyo": "27°C • 🌧 High Humidity / Rainy Season Risk",
        "Osaka": "29°C • 🌦 Very Warm & Muggy",
        "Kyoto": "28°C • 🌧 Periodic Showers / Dense Air",
        "Hakone": "22°C • 🌫 Cool, Misty Mountain Microclimate"
    };
    // Initialize default container look
    document.getElementById("weatherBox").innerHTML = travelWeather["Tokyo"];

    // 2. Map Logic
    var map = L.map('map').setView([35.15, 137.5], 6);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png').addTo(map);

    var locations = [
        {name: "Stop 1: Tokyo (Toyosu)", coords: [35.6550, 139.7961], date: "June 19-21"},
        {name: "Stop 2: Osaka", coords: [34.6937, 135.5023], date: "June 21-24"},
        {name: "Stop 3: Kyoto", coords: [35.0116, 135.7681], date: "June 24-27"},
        {name: "Stop 4: Hakone", coords: [35.2324, 139.1033], date: "June 27-29"},
        {name: "Stop 5: Tokyo (Ginza)", coords: [35.6715, 139.7649], date: "June 29-July 3"}
    ];

    var latlngs = [];
    locations.forEach((loc, index) => {
        var numberIcon = L.divIcon({
            className: 'custom-number-icon',
            html: index + 1,
            iconSize: [30, 30]
        });
        L.marker(loc.coords, {icon: numberIcon}).addTo(map).bindPopup("<b>"+loc.name+"</b><br>"+loc.date);
        latlngs.push(loc.coords);
    });
    L.polyline(latlngs, {color: '#d90429', weight: 3, opacity: 0.7, dashArray: '5, 10'}).addTo(map);

    // 3. Accurate Currency Logic
    const RATE = 213.93; 
    function convertYenToGbp() {
        const yen = document.getElementById('yenInput').value;
        const result = yen / RATE;
        document.getElementById('gbp-output').innerText = "£ " + (yen ? result.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) : "0.00");
    }
    function convertGbpToYen() {
        const gbp = document.getElementById('gbpInput').value;
        const result = gbp * RATE;
        document.getElementById('yen-output').innerText = "¥ " + (gbp ? Math.round(result).toLocaleString() : "0");
    }
</script>

